<Project Sdk="Microsoft.NET.Sdk">
  <!--
    在游戏外调用游戏自带的 ModScanner.Scan，检查一个 mod 文件夹会不会被拒绝加载、需要哪些权限。
    用法：
      export DOTNET_ROOT=~/.dotnet PATH=$PATH:~/.dotnet DOTNET_ROLL_FORWARD=Major
      dotnet build -c Release -o out
      dotnet out/ScanCheck.dll <mod 文件夹> "<游戏>/Probably Stolen_Data/Managed"
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <GameDir Condition="'$(GameDir)' == ''">/mnt/c/Program Files (x86)/Steam/steamapps/common/Probably Stolen</GameDir>
    <Managed>$(GameDir)/Probably Stolen_Data/Managed</Managed>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(Managed)/Assembly-CSharp.dll</HintPath></Reference>
    <Reference Include="DseCecil"><HintPath>$(Managed)/DseCecil.dll</HintPath></Reference>
    <Reference Include="0Harmony"><HintPath>$(Managed)/0Harmony.dll</HintPath></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(Managed)/UnityEngine.CoreModule.dll</HintPath></Reference>
  </ItemGroup>
</Project>
